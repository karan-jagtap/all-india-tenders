# ==============================================================================
# Database Configuration (PostgreSQL 16 with pgvector / SQLite Fallback)
# ==============================================================================
# Option A: PostgreSQL with pgvector (via Docker Compose: `docker compose up -d`)
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/all_india_tenders

# Option B: Local Zero-Config SQLite Fallback (Active by default if omitted)
DATABASE_URL=sqlite+aiosqlite:///app/data/all_india_tenders.db

# ==============================================================================
# Email Notification SMTP Configuration (Dispatches to kmessilj@gmail.com)
# ==============================================================================
# Option 1: Gmail App Password (Recommended)
# 1. Enable 2-Step Verification in Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sending_gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=your_sending_gmail@gmail.com

# Option 2: Resend / SendGrid / Custom SMTP
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_api_key
# SMTP_FROM=notifications@yourdomain.com
